{
  "name": "poc_medallion_pipeline_serverless",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "tags": {
    "project": "poc-medallion"
  },
  "parameters": [
    {
      "name": "catalog",
      "default": "dbw_poc_medallion"
    },
    {
      "name": "dataset_ids",
      "default": "ALL"
    }
  ],
  "email_notifications": {
    "on_failure": [
      "<your-email>"
    ]
  },
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "PAUSED"
  },
  "tasks": [
    {
      "task_key": "validate",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-email>/poc_medallion/notebooks/01_validate",
        "source": "WORKSPACE",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "dataset_ids": "{{job.parameters.dataset_ids}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "bronze",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-email>/poc_medallion/notebooks/02_bronze",
        "source": "WORKSPACE",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "dataset_ids": "{{job.parameters.dataset_ids}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "validate"
        }
      ],
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    },
    {
      "task_key": "silver",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-email>/poc_medallion/notebooks/03_silver",
        "source": "WORKSPACE",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "dataset_ids": "{{job.parameters.dataset_ids}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "bronze"
        }
      ],
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    },
    {
      "task_key": "gold",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-email>/poc_medallion/notebooks/04_gold",
        "source": "WORKSPACE",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "dataset_ids": "{{job.parameters.dataset_ids}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "silver"
        }
      ],
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    },
    {
      "task_key": "finalize",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-email>/poc_medallion/notebooks/05_finalize",
        "source": "WORKSPACE",
        "base_parameters": {
          "catalog": "{{job.parameters.catalog}}",
          "dataset_ids": "{{job.parameters.dataset_ids}}",
          "run_id": "{{job.run_id}}"
        }
      },
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "gold"
        }
      ],
      "run_if": "ALL_DONE"
    }
  ]
}